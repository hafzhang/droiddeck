---
import { t, localizePath } from '../i18n/translations';
import type { Locale } from '../i18n/translations';
import LanguagePicker from '../components/LanguagePicker.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  page?: string;
  locale?: Locale;
}

const {
  title,
  description = t('en', 'footer.tagline'),
  ogImage = "/assets/images/hero-screen.webp",
  page = "",
  locale = "en"
} = Astro.props;

const siteUrl = (Astro.site || new URL("https://droiddeck-guide.gg")).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const basePath = Astro.url.pathname.replace(/^\/(zh|ja)\//, '/');
const alternates = (['en', 'zh', 'ja'] as Locale[]).map(loc => ({
  locale: loc,
  href: new URL(localizePath(basePath, loc), siteUrl).toString()
}));
const ogLocale = locale === 'zh' ? 'zh_CN' : locale === 'ja' ? 'ja_JP' : 'en_US';
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#0b1018">
  <link rel="canonical" href={canonical}>
  {alternates.map(alt => (
    <link rel="alternate" hreflang={alt.locale} href={alt.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={alternates.find(a => a.locale === 'en')?.href} />
  <link rel="icon" href="/assets/images/favicon.ico">
  <link href="https://cdn.bootcdn.net/ajax/libs/remixicon/4.2.0/remixicon.css" rel="stylesheet">
  <link href="/assets/css/style.css" rel="stylesheet">
  <script defer src="/assets/js/main.js"></script>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:locale" content={ogLocale}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: title,
    url: canonical,
    description: description,
    inLanguage: ogLocale,
    publisher: {
      '@type': 'Organization',
      name: 'DroidDeck Guide',
      url: 'https://droiddeck-guide.gg'
    }
  })} />
</head>
<body>
  <header class="site-header">
    <div class="nav-inner">
      <a class="brand" href={localizePath('/', locale)} aria-label="DroidDeck Guide home">
        <img src="/assets/images/logo.png" alt="DroidDeck" width="36" height="36">
        <span>DroidDeck</span>
        <small>Guide</small>
      </a>
      <button class="menu-toggle" aria-controls="site-nav" aria-expanded="false" aria-label="Toggle navigation">
        <i class="ri-menu-line" aria-hidden="true"></i>
      </button>
      <nav id="site-nav" aria-label="Main navigation">
        <a href={localizePath('/', locale)} aria-current={page === "home" ? "page" : undefined}>{t(locale, 'nav.home')}</a>
        <a href={localizePath('/devices/', locale)} aria-current={page === "devices" ? "page" : undefined}>{t(locale, 'nav.devices')}</a>
        <a href={localizePath('/troubleshooting/', locale)} aria-current={page === "troubleshooting" ? "page" : undefined}>{t(locale, 'nav.troubleshooting')}</a>
        <a href={localizePath('/games/', locale)} aria-current={page === "games" ? "page" : undefined}>{t(locale, 'nav.games')}</a>
        <a href={localizePath('/compatibility-matrix/', locale)} aria-current={page === "matrix" ? "page" : undefined}>{t(locale, 'nav.matrix')}</a>
        <a href={localizePath('/compare/', locale)} aria-current={page === "compare" ? "page" : undefined}>{t(locale, 'nav.compare')}</a>
        <a href={localizePath('/updates/', locale)} aria-current={page === "updates" ? "page" : undefined}>{t(locale, 'nav.updates')}</a>
        <a href={localizePath('/#faq', locale)}>{t(locale, 'nav.faq')}</a>
      </nav>
      <div style="display:flex;align-items:center;gap:12px;margin-left:auto">
        <a href={localizePath('/search/', locale)} class="nav-search" aria-label={t(locale, 'search.label')}>
          <i class="ri-search-line" aria-hidden="true"></i>
        </a>
        <LanguagePicker locale={locale} currentPath={Astro.url.pathname} />
        <a class="nav-download" href="https://droiddeck.app/" target="_blank" rel="nofollow noopener noreferrer">
          <i class="ri-download-2-line" aria-hidden="true"></i> {t(locale, 'nav.getDroidDeck')}
        </a>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-top">
      <div>
        <a class="brand" href={localizePath('/', locale)}>
          <img src="/assets/images/logo.png" alt="DroidDeck" width="32" height="32">
          <span>DroidDeck</span>
          <small>Guide</small>
        </a>
        <p>{t(locale, 'footer.tagline')}</p>
      </div>
      <div class="footer-links">
        <a href={localizePath('/devices/', locale)}>{t(locale, 'nav.devices')}</a>
        <a href={localizePath('/troubleshooting/', locale)}>{t(locale, 'nav.troubleshooting')}</a>
        <a href={localizePath('/compare/', locale)}>{t(locale, 'nav.compare')}</a>
        <a href={localizePath('/submit-report/', locale)}>{t(locale, 'nav.submitReport')}</a>
        <a href="https://github.com/Droid-Deck/DroidDeck" target="_blank" rel="noopener noreferrer">GitHub <i class="ri-external-link-line" aria-hidden="true"></i></a>
      </div>
    </div>
    <div class="wrap footer-bottom">
      <span>{t(locale, 'footer.copyright')}</span>
      <p>{t(locale, 'footer.disclaimer')}</p>
    </div>
  </footer>

  <button class="back-top" aria-label="Back to top" hidden><i class="ri-arrow-up-line" aria-hidden="true"></i></button>
  <dialog class="image-dialog" aria-label="Image preview">
    <button class="close-image" aria-label="Close">×</button>
    <img alt="">
    <p>Scroll to view · Press Esc to close</p>
  </dialog>
</body>
</html>
