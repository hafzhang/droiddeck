---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { localizePath } from '../../../i18n/translations';

const locale = 'zh';
const [devices, games] = await Promise.all([getCollection('devices'), getCollection('games')]);

const index = [
  ...devices.map(d => ({
    type: 'device',
    title: d.data.name,
    slug: d.data.slug,
    category: d.data.soc,
    summary: d.data.summary,
    url: localizePath(`/devices/${d.data.slug}/`, locale)
  })),
  ...games.map(g => ({
    type: 'game',
    title: g.data.title,
    slug: g.data.slug,
    category: g.data.genre,
    summary: `${g.data.recommendedSettings}。${g.data.performanceNotes}`,
    url: localizePath(`/compatibility-matrix/`, locale) + `#${g.data.slug}`
  }))
];
---

<Layout
  title="搜索 — DroidDeck 指南"
  description="在 DroidDeck 兼容性数据库中搜索设备与游戏。"
  page=""
  locale={locale}
>
  <style>
    .page-header{background:var(--night);color:white;padding:90px 0 50px}
    .page-header h1{font-size:42px;margin-bottom:12px}
    .page-header p{color:#93a7ba;max-width:600px}
    .page-content{padding:50px 0 80px}
    .search-box{position:relative;max-width:640px;margin-bottom:32px}
    .search-box input{width:100%;padding:16px 20px 16px 48px;border:1px solid var(--line);border-radius:10px;font-size:16px;background:#fff}
    .search-box i{position:absolute;left:18px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:20px}
    .results{display:grid;gap:16px}
    .result-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:18px;display:flex;flex-direction:column;gap:6px}
    .result-card h3{font-size:16px;margin:0}
    .result-card h3 a{color:#203a52}
    .result-card .meta{font-size:12px;color:var(--muted);display:flex;gap:12px;flex-wrap:wrap}
    .result-card p{font-size:13px;color:var(--muted);line-height:1.6;margin:0}
    .badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 10px;border-radius:999px}
    .badge-device{background:#f0f7fc;color:#147cb9}
    .badge-game{background:#f0fdf4;color:#16a34a}
    .empty{color:var(--muted);font-size:14px}
  </style>

  <section class="page-header">
    <div class="wrap">
      <div class="hero-label"><span></span> 搜索</div>
      <h1>查找设备或游戏</h1>
      <p>按名称、类型、SoC 或设置搜索兼容性数据库。</p>
    </div>
  </section>

  <section class="page-content wrap">
    <div class="search-box">
      <i class="ri-search-line" aria-hidden="true"></i>
      <input type="search" id="search-input" placeholder="例如：Odin 2、Hades、Adreno 740" autocomplete="off" />
    </div>
    <div class="results" id="search-results">
      <p class="empty">输入关键词以搜索设备与游戏。</p>
    </div>
  </section>

  <script is:inline define:vars={{ searchIndex: index }}>
    window.__searchIndex = searchIndex;
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/fuse.js/7.0.0/fuse.basic.min.js"></script>
  <script>
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const indexData = window.__searchIndex || [];
    const fuse = new Fuse(indexData, {
      keys: ['title', 'category', 'summary'],
      threshold: 0.4,
      ignoreLocation: true
    });

    function render(items) {
      if (!items.length) {
        results.innerHTML = '<p class="empty">未找到结果，请尝试更短或不同的关键词。</p>';
        return;
      }
      results.innerHTML = items.map(item => `
        <article class="result-card">
          <div class="meta">
            <span class="badge badge-${item.type}">${item.type === 'device' ? '设备' : '游戏'}</span>
            <span>${item.category}</span>
          </div>
          <h3><a href="${item.url}">${item.title}</a></h3>
          <p>${item.summary}</p>
        </article>
      `).join('');
    }

    input.addEventListener('input', () => {
      const q = input.value.trim();
      if (!q) {
        results.innerHTML = '<p class="empty">输入关键词以搜索设备与游戏。</p>';
        return;
      }
      const found = fuse.search(q).map(r => r.item);
      render(found);
    });

    if (input.value.trim()) {
      input.dispatchEvent(new Event('input'));
    }
  </script>
</Layout>
